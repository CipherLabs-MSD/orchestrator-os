{
  "domain": "software-development",
  "version": "0.1.0",
  "description": "Software-development verification: gates, specialized evidence types, task-type requirements. Composed over orchestration/kernel/verification.json.",
  "evidence_types": {
    "test_result": "check_result",
    "build_output": "check_result",
    "static_analysis": "check_result",
    "runtime_check": "check_result",
    "screenshot": "artifact",
    "benchmark": "measurement",
    "diff_inspection": "scope_inspection"
  },
  "gates": [
    {
      "id": "G-TEST",
      "name": "Tests",
      "passes_when": "Relevant tests pass at the commit; new behaviour has new tests; no regressions.",
      "evidence_types": [
        "test_result"
      ],
      "removal_level": "D3"
    },
    {
      "id": "G-BUILD",
      "name": "Build",
      "passes_when": "Clean build from the commit.",
      "evidence_types": [
        "build_output"
      ],
      "removal_level": "D3"
    },
    {
      "id": "G-STATIC",
      "name": "Static analysis",
      "passes_when": "No new findings at or above configured severity.",
      "evidence_types": [
        "static_analysis"
      ],
      "removal_level": "D3"
    },
    {
      "id": "G-RUNTIME",
      "name": "Runtime check",
      "passes_when": "Scripted runtime check passes.",
      "evidence_types": [
        "runtime_check"
      ],
      "removal_level": "D3"
    },
    {
      "id": "G-VISUAL",
      "name": "Visual check",
      "passes_when": "Screenshots match stated expectation, judged by vision-capable role or Billy.",
      "evidence_types": [
        "screenshot",
        "review"
      ],
      "removal_level": "D3"
    },
    {
      "id": "G-BENCH",
      "name": "Benchmark",
      "passes_when": "Metric within threshold of baseline.",
      "evidence_types": [
        "benchmark"
      ],
      "removal_level": "D3"
    },
    {
      "id": "G-MIGRATION",
      "name": "Migration safety",
      "passes_when": "Dry run on copy succeeds; rollback tested; counts/checksums reconciled.",
      "evidence_types": [
        "runtime_check",
        "test_result"
      ],
      "removal_level": "D4"
    },
    {
      "id": "G-SECURITY",
      "name": "Security",
      "passes_when": "Security review passes; dependency audit clean at threshold.",
      "evidence_types": [
        "review",
        "static_analysis"
      ],
      "removal_level": "D4"
    }
  ],
  "task_type_gates": {
    "bug_fix": [
      "G-TEST",
      "G-REVIEW"
    ],
    "feature_backend": [
      "G-TEST",
      "G-BUILD",
      "G-STATIC",
      "G-REVIEW"
    ],
    "feature_ui": [
      "G-TEST",
      "G-BUILD",
      "G-VISUAL",
      "G-REVIEW"
    ],
    "refactor": [
      "G-TEST",
      "G-STATIC",
      "G-REVIEW"
    ],
    "migration": [
      "G-MIGRATION",
      "G-TEST",
      "G-REVIEW"
    ],
    "security_sensitive": [
      "G-SECURITY",
      "G-TEST",
      "G-REVIEW"
    ],
    "performance": [
      "G-BENCH",
      "G-TEST"
    ]
  }
}
