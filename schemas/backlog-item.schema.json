{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CipherLabs-MSD/orchestrator-os/schemas/backlog-item.schema.json",
  "x-oos-schema-version": 1,
  "title": "OOS backlog item",
  "description": "One item in project/backlog.json (the Orchestrator OS project's own backlog).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "milestone", "status", "depends_on", "gates"],
  "properties": {
    "id": { "type": "string", "pattern": "^OOS-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "milestone": { "type": "string", "pattern": "^M[0-9]+$" },
    "status": { "type": "string", "enum": ["proposed", "ready", "in_progress", "verifying", "done", "blocked", "cancelled"] },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^OOS-[0-9]{4}$" } },
    "blocked_by_questions": { "type": "array", "items": { "type": "string", "pattern": "^OQ-[0-9]{3}$" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "gates": { "type": "array", "items": { "type": "string", "pattern": "^G-[A-Z]+$" } },
    "expected_level": { "type": "string", "enum": ["D1", "D2", "D3", "D4"] }
  }
}
