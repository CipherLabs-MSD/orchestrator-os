{
  "version": "0.1.0",
  "description": "Decision authority policy. Human-readable source: docs/DECISION_ENGINE.md. Changing this file is itself a D4 decision.",
  "levels": {
    "D1": { "name": "autonomous", "record": "commit message / run log" },
    "D2": { "name": "autonomous + log", "record": "memory/DECISIONS/DEC-NNNN" },
    "D3": { "name": "autonomous within constraints + ADR", "record": "docs/adr/ADR-NNNN before integration; digest mention" },
    "D4": { "name": "human escalation", "record": "ESC-NNNN then DEC with decided_by=billy" }
  },
  "dimensions": ["impact", "reversibility", "uncertainty", "cost", "security", "vision_alignment"],
  "dimension_mapping": {
    "impact":           ["D1", "D1", "D3", "D3"],
    "reversibility":    ["D1", "D1", "D3", "D4"],
    "uncertainty":      ["D1", "D1", "D2", "D3"],
    "cost":             ["D1", "D1", "D2", "D4"],
    "security":         ["D1", "D2", "D3", "D4"],
    "vision_alignment": ["D1", "D2", "D3", "D4"]
  },
  "combination_rules": [
    { "id": "impact_and_irreversible", "when": { "impact": 2, "reversibility": 2 }, "level": "D4" },
    { "id": "security_and_uncertain", "when": { "security": 2, "uncertainty": 2 }, "level": "D4" },
    { "id": "productwide_reinterpretation", "when": { "vision_alignment": 2, "impact": 3 }, "level": "D4" }
  ],
  "class_floors": {
    "general": "D1",
    "dependency_change": "D2",
    "api_contract_change": "D2",
    "ci_cd_change": "D2",
    "persistent_schema_change": "D3",
    "auth_or_crypto_change": "D3",
    "new_service_or_datastore": "D3",
    "destructive_data_or_history": "D4",
    "spend_money_or_license": "D4",
    "production_deploy_or_infrastructure": "D4",
    "external_communication": "D4",
    "requirement_or_vision_change": "D4",
    "oos_policy_or_authority_change": "D4",
    "reserved_for_billy": "D4"
  },
  "low_confidence_rounds_up": true,
  "d3_conditions": [
    "within accepted product intent",
    "reversibility <= 2 with written rollback path",
    "no conflict with hard constraint or requirement",
    "at least two alternatives compared in ADR",
    "spike evidence first when uncertainty >= 2",
    "does not supersede a D4-decided ADR"
  ],
  "integration_authority": {
    "default": "billy",
    "grantable_classes": ["D1", "D2"],
    "grant_level": "D4"
  },
  "golden_examples": [
    { "title": "Rename a private helper", "class": "general", "scores": [0, 0, 0, 0, 0, 0], "expected": "D1" },
    { "title": "Fix off-by-one with regression test", "class": "general", "scores": [0, 0, 0, 0, 0, 0], "expected": "D1" },
    { "title": "Choose a date library", "class": "dependency_change", "scores": [1, 1, 1, 0, 0, 0], "expected": "D2" },
    { "title": "Shape a new internal service interface", "class": "api_contract_change", "scores": [1, 1, 1, 0, 0, 1], "expected": "D2" },
    { "title": "File saves to SQLite, no user data yet", "class": "persistent_schema_change", "scores": [2, 1, 1, 0, 0, 1], "expected": "D3" },
    { "title": "File saves to SQLite, user saves must migrate", "class": "persistent_schema_change", "scores": [2, 2, 1, 0, 0, 1], "expected": "D4" },
    { "title": "Add OAuth login", "class": "auth_or_crypto_change", "scores": [2, 1, 2, 0, 2, 1], "expected": "D4" },
    { "title": "Drop multiplayer to hit a milestone", "class": "requirement_or_vision_change", "scores": [3, 1, 0, 0, 0, 3], "expected": "D4" },
    { "title": "Subscribe to a paid API tier", "class": "spend_money_or_license", "scores": [1, 1, 0, 3, 0, 1], "expected": "D4" }
  ]
}
